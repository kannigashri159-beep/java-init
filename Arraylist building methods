        y.add(10);
        y.add(30);
        y.add(60);  
        y.add(20);
        y.add(90);
        y.clone();
        System.out.println(y);
        y.set(3,65);
        System.out.println(y);
        y.ensureCapacity(100);
        System.out.println(y);
           
    }}

